// Deployment compat for provider "minimax-code": transport/wire contract of this deployment,
// plus per-model residues the class stratum does not explain.

provider "minimax-code" {
	supports-developer-role #false
	supports-reasoning-effort #false
	supports-store #false
	models "MiniMax-M3" {
		thinking-efforts "minimal" "low" "medium" "high"
	}
}
