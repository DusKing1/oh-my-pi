// Provider-wire compat for "sarvam"; regenerated from the frozen census using deployment contract selectors.

provider "sarvam" {
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "sarvam-105b" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh"
		thinking-mode "effort"
	}
}
