// Provider-wire compat for "agnes-plan"; regenerated from the frozen census using deployment contract selectors.

provider "agnes-plan" {
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "agnes-2.0-flash" {
		thinking-efforts "minimal" "low" "medium" "high"
		thinking-format "qwen-chat-template"
		thinking-mode "effort"
	}
}
