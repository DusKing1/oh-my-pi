// Deployment compat for provider "kimi-code": transport/wire contract of this deployment,
// plus per-model residues the class stratum does not explain.

provider "kimi-code" {
	class "unknown" {
		thinking-efforts "minimal" "low" "medium" "high"
		thinking-mode "effort"
		reasoning-content-field "reasoning_content"
		supports-developer-role #false
		thinking-format "kimi"
	}
	models "kimi-for-coding" "kimi-for-coding-highspeed" {
		supports-developer-role #false
	}
	models "kimi-k2.5" {
		thinking-efforts "minimal" "low" "medium" "high"
	}
}
