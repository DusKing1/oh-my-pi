// Deployment compat for provider "amazon-bedrock": transport/wire contract of this deployment,
// plus per-model residues the family stratum does not explain.

provider "amazon-bedrock" {
	family "deepseek" {
		thinking-efforts "minimal" "low" "medium" "high"
	}
	family "minimax" {
		thinking-mode "budget"
	}
	family "unknown" {
		thinking-efforts "minimal" "low" "medium" "high"
		thinking-mode "budget"
	}
	models "moonshot.kimi-k2-thinking" {
		thinking-requires-effort #true
	}
}
