// Provider-wire compat for "xai-oauth"; regenerated from the frozen census using deployment contract selectors.

provider "xai-oauth" {
	class "xai" {
		family "grok" {
			filter-reasoning-history #true
			include-encrypted-reasoning #false
			reasoning-effort-map {
				minimal "low"
			}
			supports-image-detail-original #false
			thinking-mode "effort"
			revision ">=0.1 <4.3" {
				omit-reasoning-effort #true
			}
			revision ">=4.3 <4.20" {
				omit-reasoning-effort #false
				supports-reasoning-effort #true
			}
		}
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "*reasoning" "grok-build" {
		omit-reasoning-effort #true
		supports-reasoning-effort #false
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "grok-4.20-multi-agent-0309" {
		omit-reasoning-effort #false
		supports-reasoning-effort #true
	}
}
