// Deployment compat for provider "xai-oauth": transport/wire contract of this deployment,
// plus per-model residues the class stratum does not explain.

provider "xai-oauth" {
	filter-reasoning-history #true
	include-encrypted-reasoning #false
	reasoning-effort-map {
		minimal "low"
	}
	supports-image-detail-original #false
	models "grok-4.20-0309-non-reasoning" "grok-4.20-0309-reasoning" "grok-build" "grok-build-0.1" \
		"grok-composer-2.5-fast" {
		omit-reasoning-effort #true
		supports-reasoning-effort #false
	}
	models "grok-4.20-multi-agent-0309" "grok-4.3" "grok-4.5" {
		omit-reasoning-effort #false
		supports-reasoning-effort #true
	}
}
