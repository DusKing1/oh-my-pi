// Deployment compat for provider "bedrock-mantle": transport/wire contract of this deployment,
// plus per-model residues the class stratum does not explain.

provider "bedrock-mantle" {
	thinking-mode "effort"
	models "openai.gpt-5.4" "openai.gpt-5.5" {
		thinking-efforts "low" "medium" "high" "xhigh"
	}
	models "openai.gpt-5.6-*" {
		thinking-efforts "low" "medium" "high" "xhigh" "max"
	}
}
