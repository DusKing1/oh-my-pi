// Deployment compat for provider "zhipu-coding-plan": transport/wire contract of this deployment,
// plus per-model residues the class stratum does not explain.

provider "zhipu-coding-plan" {
	models "glm-4.5" "glm-4.6" "glm-5" {
		thinking-efforts "minimal" "low" "medium" "high"
	}
	models "glm-4.5-air" "glm-4.6v" "glm-4.7" "glm-5-turbo" \
		"glm-5.1" "glm-5v-turbo" {
		thinking-efforts "minimal" "low" "medium" "high"
		reasoning-content-field "reasoning_content"
		supports-developer-role #false
		thinking-format "zai"
	}
	models "glm-5.2" {
		thinking-efforts "high" "max"
		reasoning-content-field "reasoning_content"
		supports-developer-role #false
		thinking-format "zai"
	}
	models "glm-5.2-highspeed" "glm-5.2-highspeed[1m]" {
		supports-developer-role #false
	}
}
