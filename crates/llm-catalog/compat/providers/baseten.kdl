// Deployment compat for provider "baseten": transport/wire contract of this deployment,
// plus per-model residues the family stratum does not explain.

provider "baseten" {
	family "gpt-oss" {
		thinking-efforts "high" "max"
	}
	family "unknown" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh"
		thinking-mode "effort"
	}
	models "zai-org/GLM-5.2" {
		thinking-efforts "high" "max"
	}
}
