// Deployment compat for provider "azure": transport/wire contract of this deployment,
// plus per-model residues the class stratum does not explain.

provider "azure" {
	models "gpt-5.1" {
		thinking-efforts "minimal" "low" "medium" "high"
	}
	models "gpt-5.2" "gpt-5.2-codex" "gpt-5.3-codex" {
		thinking-efforts "low" "medium" "high" "xhigh"
	}
}
