// Deployment compat for provider "zai": transport/wire contract of this deployment,
// plus per-model residues the class stratum does not explain.

provider "zai" {
	models "glm-4.5" "glm-4.5-air" "glm-4.6" "glm-4.6v" \
		"glm-4.7" "glm-5" "glm-5-turbo" "glm-5.1" \
		"glm-5v-turbo" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh"
		thinking-mode "budget"
	}
	models "glm-5.2" {
		thinking-efforts "high" "max"
		thinking-mode "anthropic-budget-effort"
	}
}
