// Deployment compat for provider "huggingface": transport/wire contract of this deployment,
// plus per-model residues the class stratum does not explain.

provider "huggingface" {
	class "unknown" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh"
		thinking-mode "effort"
	}
	models "deepseek-ai/DeepSeek-V3.1" "deepseek-ai/DeepSeek-V4-Flash-0731" {
		requires-reasoning-content-for-all-assistant-turns #true
	}
	models "zai-org/GLM-5.2" {
		thinking-efforts "minimal" "low" "medium" "high" "max"
	}
}
