// Deployment compat for provider "google-gemini-cli": transport/wire contract of this deployment,
// plus per-model residues the class stratum does not explain.

provider "google-gemini-cli" {
	models "gemini-2.5-flash" "gemini-2.5-pro" {
		thinking-mode "budget"
	}
	models "gemini-3*" {
		thinking-mode "google-level"
	}
}
