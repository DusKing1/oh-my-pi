// Deployment compat for provider "google-antigravity": transport/wire contract of this deployment,
// plus per-model residues the class stratum does not explain.

provider "google-antigravity" {
	class "anthropic" {
		thinking-efforts "minimal" "low" "medium" "high"
		thinking-mode "budget"
	}
	models "gemini-2.5-*" {
		thinking-mode "budget"
	}
	models "gemini-3-flash" "gemini-3.5-flash" {
		thinking-effort-budgets {
			high 10000
			low 1000
			medium 4000
			minimal 1000
		}
		thinking-mode "budget"
		thinking-suppress-when-off #true
	}
	models "gemini-3-pro" {
		thinking-mode "google-level"
		thinking-suppress-when-off #true
	}
	models "gemini-3.1-flash-lite" "gemini-3.6-flash" {
		thinking-mode "google-level"
	}
	models "gemini-3.1-pro" {
		thinking-effort-budgets {
			high 10001
			low 1001
		}
		thinking-mode "budget"
		thinking-suppress-when-off #true
	}
}
