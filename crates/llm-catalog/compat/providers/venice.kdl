// Provider-wire compat for "venice"; regenerated from the frozen census using deployment contract selectors.

provider "venice" {
	thinking-mode "effort"
	class "gemini" {
		revision ">=3 <3.1" {
			thinking-requires-effort #true
		}
		revision ">=3.1 <3.7" {
			thinking-efforts "minimal" "low" "medium" "high" "xhigh"
		}
	}
	class "unknown" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh"
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "*2-0" "*4b" "e*" "google.*" "grok-4-20-*" "grok-41-fast" "grok-code-fast-1" \
		"hermes-3-llama-3.1-405b" "minimax-m21" "qwen3-coder-480b-a35b-instruct" "venice-uncensored" {
		supports-usage-in-streaming #false
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "arcee-trinity-large-thinking" {
		thinking-requires-effort #true
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "deepseek-v4-flash*" {
		requires-reasoning-content-for-all-assistant-turns #true
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "gemini-3-flash-preview" {
		thinking-efforts "minimal" "low" "medium" "high"
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "gemini-3-pro-preview" {
		thinking-efforts "low" "high"
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "kimi-k2-thinking" {
		supports-usage-in-streaming #false
		thinking-requires-effort #true
	}
	// residue: taxonomy ranks and exact globs do not isolate these models.
	models "qwen3-235b" {
		thinking-format "qwen"
	}
}
