// Deployment compat for provider "venice": transport/wire contract of this deployment,
// plus per-model residues the class stratum does not explain.

provider "venice" {
	class "unknown" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh"
		thinking-mode "effort"
	}
	models "aion-labs-aion-2-0" "aion-labs.aion-2-0" "claude-opus-45" "claude-sonnet-45" \
		"e2ee-deepseek-v4-flash" "e2ee-gemma-3-27b-p" "e2ee-gemma-4-26b-a4b-uncensored-p" "e2ee-gemma-4-31b" \
		"e2ee-glm-4-7-flash-p" "e2ee-glm-4-7-p" "e2ee-glm-5" "e2ee-glm-5-1" \
		"e2ee-glm-5-2-p" "e2ee-gpt-oss-120b-p" "e2ee-gpt-oss-20b-p" "e2ee-qwen-2-5-7b-p" \
		"e2ee-qwen3-30b-a3b-p" "e2ee-qwen3-5-122b-a10b" "e2ee-qwen3-6-27b" "e2ee-qwen3-6-35b-a3b" \
		"e2ee-qwen3-6-35b-a3b-uncensored-p" "e2ee-qwen3-vl-30b-a3b-p" "e2ee-venice-uncensored-24b-p" "gemini-3-pro-preview" \
		"google.gemma-4-26b-a4b-it" "google.gemma-4-31b-it" "grok-4-20-beta" "grok-4-20-multi-agent" \
		"grok-4-20-multi-agent-beta" "grok-41-fast" "grok-code-fast-1" "hermes-3-llama-3.1-405b" \
		"minimax-m21" "mistral-31-24b" "qwen3-4b" "qwen3-coder-480b-a35b-instruct" \
		"venice-uncensored" {
		supports-usage-in-streaming #false
	}
	models "arcee-trinity-large-thinking" {
		thinking-requires-effort #true
	}
	models "deepseek-v4-flash" {
		thinking-efforts "low" "high" "max"
	}
	models "kimi-k2-thinking" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh"
		supports-usage-in-streaming #false
	}
	models "minimax-m3" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh"
	}
}
