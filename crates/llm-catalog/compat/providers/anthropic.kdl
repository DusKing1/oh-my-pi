// Deployment compat for provider "anthropic": transport/wire contract of this deployment,
// plus per-model residues the class stratum does not explain.

provider "anthropic" {
	models "claude-3-7-sonnet-20250219" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh"
		disable-adaptive-thinking #false
		escape-builtin-tool-names #false
		official-endpoint #true
		replay-unsigned-thinking #false
		requires-thinking-enabled #false
		requires-tool-result-id #false
		signing-endpoint #true
		supports-eager-tool-input-streaming #true
		supports-forced-tool-choice #true
		supports-long-cache-retention #true
		supports-mid-conversation-system #false
		supports-sampling-params #true
	}
	models "claude-3-opus-20240229" "claude-3-sonnet-20240229" {
		disable-adaptive-thinking #false
		escape-builtin-tool-names #false
		official-endpoint #true
		replay-unsigned-thinking #false
		requires-thinking-enabled #false
		requires-tool-result-id #false
		signing-endpoint #true
		supports-eager-tool-input-streaming #true
		supports-forced-tool-choice #true
		supports-long-cache-retention #true
		supports-mid-conversation-system #false
		supports-sampling-params #true
	}
	models "claude-fable-5" "claude-opus-4-7" "claude-opus-4-8" "claude-opus-5" \
		"claude-sonnet-5" {
		thinking-efforts "low" "medium" "high" "xhigh" "max"
		thinking-mode "anthropic-adaptive"
		thinking-supports-display #true
	}
	models "claude-haiku-4-5" "claude-opus-4-0" "claude-opus-4-1" "claude-sonnet-4-0" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh"
	}
	models "claude-haiku-4-5-20251001" "claude-sonnet-4-5" "claude-sonnet-4-5-20250929" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh"
		thinking-mode "budget"
	}
	models "claude-opus-4-5" "claude-opus-4-5-20251101" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh"
		thinking-mode "anthropic-budget-effort"
	}
	models "claude-opus-4-6" {
		thinking-efforts "low" "medium" "high" "max"
		thinking-mode "anthropic-adaptive"
	}
	models "claude-sonnet-4-6" {
		thinking-efforts "low" "medium" "high"
		thinking-mode "anthropic-adaptive"
	}
}
