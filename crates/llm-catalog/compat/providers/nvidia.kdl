// Deployment compat for provider "nvidia": transport/wire contract of this deployment,
// plus per-model residues the class stratum does not explain.

provider "nvidia" {
	class "kimi" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh"
	}
	class "unknown" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh"
		thinking-mode "effort"
	}
	models "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning" {
		thinking-requires-effort #true
	}
	models "z-ai/glm-5.1" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh"
	}
	models "z-ai/glm-5.2" {
		thinking-efforts "minimal" "low" "medium" "high" "max"
	}
}
