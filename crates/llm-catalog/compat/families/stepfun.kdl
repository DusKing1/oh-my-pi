// Model-lineage compat for the "stepfun" family (census: model-family predicates in pi
// dialect selection / transform-messages; oracle-verified by tests/compat_cascade.rs).

family "stepfun" {
	on "aimlapi" "huggingface" "kilo" "nanogpt" "novita" "nvidia" "openrouter" "stepfun" "stepfun-plan" "zenmux" {
		thinking-mode "effort"
	}
	on "aimlapi" "huggingface" "kilo" "nanogpt" "novita" "nvidia" "stepfun" "stepfun-plan" "vercel-ai-gateway" "zenmux" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh"
	}
}
