// Model-lineage compat for the "amazon" family (census: model-family predicates in pi
// dialect selection / transform-messages; oracle-verified by tests/compat_cascade.rs).

family "amazon" {
	on "kilo" "nanogpt" "openrouter" {
		thinking-mode "effort"
	}
	on "kilo" "nanogpt" "vercel-ai-gateway" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh"
	}
}
