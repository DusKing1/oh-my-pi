// Model-lineage compat for the "gemma" class (census: model-class predicates in pi
// dialect selection / transform-messages; oracle-verified by tests/compat_cascade.rs).

class "gemma" {
	on "aiand" "aimlapi" "cerebras" "coreweave" "crofai" "friendli" "huggingface" "kilo" "nanogpt" "novita" "nvidia" "ollama-cloud" "openrouter" "scaleway" "together" "zenmux" {
		thinking-mode "effort"
	}
	on "aiand" "aimlapi" "cerebras" "coreweave" "crofai" "friendli" "huggingface" "kilo" "nanogpt" "novita" "nvidia" "scaleway" "together" "vercel-ai-gateway" "zenmux" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh"
	}
	on "google" "ollama-cloud" "openrouter" {
		thinking-efforts "minimal" "low" "medium" "high"
	}
	on "google" "vercel-ai-gateway" {
		thinking-mode "budget"
	}
}
