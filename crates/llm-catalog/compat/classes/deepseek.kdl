// Model-lineage compat for "deepseek"; regenerated from the frozen census using class taxonomy selectors.

class "deepseek" {
	on "aiand" "aimlapi" "alibaba-token-plan" "baseten" "coreweave" "deepseek" "fireworks" \
		"huggingface" "kilo" "nanogpt" "novita" "nvidia" "opencode-go" "opencode-zen" "together" \
		"venice" "vercel-ai-gateway" "wafer-serverless" "zenmux" {
		family "pro" {
			requires-reasoning-content-for-all-assistant-turns #true
		}
	}
	on "aiand" "aimlapi" "alibaba-token-plan" "baseten" "coreweave" "deepseek" "fireworks" \
		"huggingface" "kilo" "nanogpt" "novita" "nvidia" "opencode-go" "opencode-zen" "together" \
		"venice" "wafer-serverless" "zenmux" {
		family "pro" {
			thinking-efforts "high" "max"
		}
	}
	on "aiand" "aimlapi" "coreweave" "deepseek" "fireworks" "gmi-cloud" "huggingface" "kilo" \
		"nanogpt" "novita" "nvidia" "ollama-cloud" "opencode-zen" "openrouter" "together" "venice" \
		"wafer-serverless" "zenmux" {
		family "flash" {
			thinking-efforts "low" "high" "max"
		}
	}
	on "aiand" "aimlapi" "coreweave" "deepseek" "fireworks" "gmi-cloud" "huggingface" "novita" \
		"nvidia" "ollama-cloud" "opencode-go" "opencode-zen" "together" "umans" "vercel-ai-gateway" \
		"wafer-serverless" "zenmux" {
		family "flash" {
			requires-reasoning-content-for-all-assistant-turns #true
		}
	}
	on "aimlapi" "groq" "huggingface" "kilo" "nanogpt" "novita" "nvidia" "together" "zenmux" {
		family "r1" {
			thinking-efforts "high" "max"
		}
	}
	on "aimlapi" "groq" "huggingface" "novita" "nvidia" "together" "vercel-ai-gateway" "zenmux" {
		family "r1" {
			requires-reasoning-content-for-all-assistant-turns #true
		}
	}
	on "alibaba-token-plan" "deepseek" {
		supports-developer-role #false
	}
	on "amazon-bedrock" "umans" "vercel-ai-gateway" {
		thinking-mode "budget"
	}
	on "deepseek" "fireworks" {
		family "pro" {
			requires-assistant-content-for-tool-calls #true
		}
	}
	on "deepseek" "fireworks" "opencode-go" {
		family "pro" {
			supports-tool-choice #false
		}
	}
	on "deepseek" "opencode-go" {
		family "pro" {
			max-tokens-field "max_tokens"
			reasoning-content-field "reasoning_content"
			requires-reasoning-content-for-tool-calls #true
		}
	}
	on "friendli" "huggingface" "kilo" "nanogpt" "novita" "nvidia" "ollama-cloud" "qianfan" \
		"together" "venice" "yandex" "zenmux" {
		family "v3" {
			thinking-efforts "high" "max"
		}
	}
	on "friendli" "nvidia" "ollama-cloud" "qianfan" "venice" "yandex" "zenmux" {
		family "v3" {
			requires-reasoning-content-for-all-assistant-turns #true
		}
	}
	on "umans" "vercel-ai-gateway" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh"
	}
}
