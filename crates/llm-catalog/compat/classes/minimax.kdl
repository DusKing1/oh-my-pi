// Model-lineage compat for "minimax"; regenerated from the frozen census using class taxonomy selectors.

class "minimax" {
	on "aimlapi" "coreweave" "fireworks" "huggingface" "kilo" "nanogpt" "novita" "nvidia" \
		"opencode-go" "opencode-zen" "together" "venice" "wafer-serverless" "zenmux" {
		family "m3" {
			thinking-efforts "minimal" "low" "medium" "high" "xhigh"
		}
	}
	on "alibaba-coding-plan" "amazon-bedrock" "coreweave" "fireworks" "friendli" "huggingface" "kilo" \
		"minimax" "minimax-cn" "minimax-code" "minimax-code-cn" "nanogpt" "novita" "nvidia" \
		"ollama-cloud" "opencode-go" "opencode-zen" "openrouter" "together" "venice" "vercel-ai-gateway" \
		"zenmux" {
		family "m2" {
			thinking-requires-effort #true
		}
	}
	on "alibaba-coding-plan" "coreweave" "fireworks" "friendli" "huggingface" "kilo" "minimax" \
		"minimax-cn" "minimax-code" "minimax-code-cn" "nanogpt" "novita" "nvidia" "opencode-go" \
		"opencode-zen" "openrouter" "together" "venice" "vercel-ai-gateway" "zenmux" {
		family "m2" {
			thinking-efforts "low" "medium" "high"
		}
	}
	on "alibaba-coding-plan" "minimax-code" "minimax-code-cn" "wafer-serverless" {
		supports-developer-role #false
	}
	on "amazon-bedrock" "ollama-cloud" {
		thinking-efforts "minimal" "low" "medium" "high"
	}
	on "kilo" "novita" {
		family "m1" {
			thinking-efforts "minimal" "low" "medium" "high" "xhigh"
		}
	}
	on "minimax" "minimax-cn" "vercel-ai-gateway" {
		thinking-mode "anthropic-adaptive"
		family "m3" {
			thinking-efforts "low" "medium" "high"
		}
	}
	on "minimax-code" "minimax-code-cn" {
		supports-reasoning-effort #false
		supports-store #false
	}
	on "minimax-code" "minimax-code-cn" "wafer-serverless" {
		reasoning-content-field "reasoning_content"
	}
}
