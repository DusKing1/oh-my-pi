// Model-lineage compat for the "mimo" class (census: model-class predicates in pi
// dialect selection / transform-messages; oracle-verified by tests/compat_cascade.rs).

class "mimo" {
	on "aimlapi" "huggingface" "kilo" "nanogpt" "novita" "opencode-go" "opencode-zen" "openrouter" "venice" "xiaomi" "xiaomi-token-plan-ams" "xiaomi-token-plan-cn" "xiaomi-token-plan-sgp" "zenmux" {
		thinking-mode "effort"
	}
	on "aimlapi" "huggingface" "kilo" "nanogpt" "novita" "opencode-go" "opencode-zen" "openrouter" "venice" "zenmux" {
		thinking-efforts "low" "medium" "high"
	}
	on "xiaomi" "xiaomi-token-plan-ams" "xiaomi-token-plan-cn" "xiaomi-token-plan-sgp" {
		thinking-efforts "minimal" "low" "medium" "high"
	}
}
