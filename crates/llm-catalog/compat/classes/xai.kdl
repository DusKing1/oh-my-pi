// Model-lineage compat for "xai"; regenerated from the frozen census using class taxonomy selectors.

class "xai" {
	on "aimlapi" "kilo" "nanogpt" "opencode-go" "opencode-zen" "venice" "vercel-ai-gateway" \
		"xai-oauth" "zenmux" {
		family "grok" {
			thinking-efforts "minimal" "low" "medium" "high" "xhigh"
		}
	}
	on "cursor" "openrouter" "xai" {
		family "grok" {
			thinking-efforts "minimal" "low" "medium" "high"
		}
	}
	on "github-copilot" "xai-oauth" {
		family "grok" {
			revision ">=0.1 <4.3" {
				supports-reasoning-effort #false
			}
		}
	}
}
