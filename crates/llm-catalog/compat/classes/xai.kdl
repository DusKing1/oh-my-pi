// Model-lineage compat for the "xai" class (census: model-class predicates in pi
// dialect selection / transform-messages; oracle-verified by tests/compat_cascade.rs).

class "xai" {
	models "grok-4.20-0309-reasoning" "grok-4.20-beta-latest-reasoning" "xai/grok-4-fast-reasoning" "xai/grok-4.1-fast-reasoning" \
		"xai/grok-4.20-reasoning" "xai/grok-4.20-reasoning-beta" {
		thinking-requires-effort #true
	}
	on "aimlapi" "cursor" "github-copilot" "kilo" "nanogpt" "opencode-go" "opencode-zen" "openrouter" "venice" "xai" "xai-oauth" "zenmux" {
		thinking-mode "effort"
	}
	on "aimlapi" "kilo" "nanogpt" "opencode-go" "opencode-zen" "venice" "vercel-ai-gateway" "xai-oauth" "zenmux" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh"
	}
	on "cursor" "openrouter" "xai" {
		thinking-efforts "minimal" "low" "medium" "high"
	}
}
