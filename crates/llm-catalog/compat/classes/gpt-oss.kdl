// Model-lineage compat for the "gpt-oss" class (census: model-class predicates in pi
// dialect selection / transform-messages; oracle-verified by tests/compat_cascade.rs).

class "gpt-oss" {
	on "aiand" "aimlapi" "baseten" "cerebras" "coreweave" "fireworks" "google-vertex" "groq" "huggingface" "kilo" "nanogpt" "novita" "nvidia" "ollama-cloud" "openrouter" "ovhai" "scaleway" "synthetic" "together" "venice" {
		thinking-mode "effort"
	}
	on "aiand" "aimlapi" "cerebras" "coreweave" "fireworks" "google-vertex" "groq" "huggingface" "kilo" "nanogpt" "novita" "nvidia" "openrouter" "ovhai" "scaleway" "synthetic" "together" {
		thinking-efforts "low" "medium" "high"
	}
	on "amazon-bedrock" "google-antigravity" "ollama-cloud" {
		thinking-efforts "minimal" "low" "medium" "high"
	}
	on "amazon-bedrock" "google-antigravity" "vercel-ai-gateway" {
		thinking-mode "budget"
	}
	on "venice" "vercel-ai-gateway" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh"
	}
}
