// Model-lineage compat for the "openai" class (census: model-class predicates in pi
// dialect selection / transform-messages; oracle-verified by tests/compat_cascade.rs).

class "openai" {
	models "codex-mini" "codex-mini-latest" "gpt-chat-latest" "gpt-realtime-2.1" \
		"o1" "o1-mini" "o1-pro" "o3" \
		"o3-deep-research" "o3-mini" "o3-pro" "o4-mini" \
		"o4-mini-deep-research" "openai/codex-mini" "openai/gpt-latest" "openai/o3-pro-2025-06-10" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh"
	}
	models "gpt-5" "gpt-5-codex" "gpt-5-mini" "gpt-5-mini-2025-08-07" \
		"gpt-5-nano" "gpt-5-pro" "gpt-5.1-2025-11-13" "gpt-5.1-chat" \
		"gpt-5.1-chat-latest" "gpt-5.1-codex" "gpt-5.1-codex-max" "gpt-5.1-codex-max-high" \
		"openai/gpt-5" "openai/gpt-5-chat" "openai/gpt-5-codex" "openai/gpt-5-codex:batch" \
		"openai/gpt-5-image" "openai/gpt-5-image-mini" "openai/gpt-5-mini" "openai/gpt-5-mini:batch" \
		"openai/gpt-5-nano" "openai/gpt-5-nano:batch" "openai/gpt-5-pro" "openai/gpt-5-pro:batch" \
		"openai/gpt-5.1" "openai/gpt-5.1-2025-11-13" "openai/gpt-5.1-codex" "openai/gpt-5.1-codex-max" \
		"openai/gpt-5.1-instant" "openai/gpt-5.1-thinking" "openai/gpt-5.1:batch" "openai/gpt-5:batch" \
		"openai/o1:batch" "openai/o3-mini-high:batch" "openai/o3-mini:batch" "openai/o3-pro:batch" \
		"openai/o3:batch" "openai/o4-mini-high:batch" "openai/o4-mini:batch" {
		thinking-efforts "minimal" "low" "medium" "high"
	}
	models "gpt-5.1-codex-mini" "openai/gpt-5.1-codex-mini" {
		thinking-efforts "medium" "high"
	}
	models "gpt-5.2-chat" "gpt-5.2-chat-latest" "gpt-5.2-pro" "gpt-5.3-chat" \
		"gpt-5.3-codex-spark" "gpt-5.4" "gpt-5.4-mini" "gpt-5.4-nano" \
		"gpt-5.4-pro" "gpt-5.5" "gpt-5.5-pro" "openai/gpt-5.2" \
		"openai/gpt-5.2-codex" "openai/gpt-5.2-pro" "openai/gpt-5.2-pro:batch" "openai/gpt-5.2:batch" \
		"openai/gpt-5.3-codex" "openai/gpt-5.4" "openai/gpt-5.4-mini" "openai/gpt-5.4-mini:batch" \
		"openai/gpt-5.4-nano" "openai/gpt-5.4-nano:batch" "openai/gpt-5.4-pro" "openai/gpt-5.4-pro:batch" \
		"openai/gpt-5.4:batch" "openai/gpt-5.5" "openai/gpt-5.5-instant" "openai/gpt-5.5-pro" \
		"openai/gpt-5.5-pro:batch" "openai/gpt-5.5:batch" {
		thinking-efforts "low" "medium" "high" "xhigh"
	}
	models "gpt-5.6" "gpt-5.6-cyber" "gpt-5.6-luna" "gpt-5.6-luna-pro" \
		"gpt-5.6-sol" "gpt-5.6-sol-pro" "gpt-5.6-terra" "gpt-5.6-terra-pro" \
		"openai/gpt-5.6-luna" "openai/gpt-5.6-luna-pro" "openai/gpt-5.6-luna-pro:batch" "openai/gpt-5.6-luna:batch" \
		"openai/gpt-5.6-sol" "openai/gpt-5.6-sol-pro" "openai/gpt-5.6-sol-pro:batch" "openai/gpt-5.6-sol:batch" \
		"openai/gpt-5.6-terra" "openai/gpt-5.6-terra-pro" "openai/gpt-5.6-terra-pro:batch" "openai/gpt-5.6-terra:batch" \
		"stealth/gpt-5.6-sol" {
		thinking-efforts "low" "medium" "high" "xhigh" "max"
	}
	models "o1" "o1-mini" "o1-pro" "o3" \
		"o3-deep-research" "o3-mini" "o3-pro" "o4-mini" \
		"o4-mini-deep-research" "openai/gpt-5.1-thinking" "openai/o1" "openai/o1:batch" \
		"openai/o3" "openai/o3-deep-research" "openai/o3-mini" "openai/o3-mini-high" \
		"openai/o3-mini-high:batch" "openai/o3-mini:batch" "openai/o3-pro" "openai/o3-pro-2025-06-10" \
		"openai/o3-pro:batch" "openai/o3:batch" "openai/o4-mini" "openai/o4-mini-deep-research" \
		"openai/o4-mini-high" "openai/o4-mini-high:batch" "openai/o4-mini:batch" {
		thinking-requires-effort #true
	}
	on "aimlapi" "azure" "cursor" "github-copilot" "gitlab-duo" "kilo" "nanogpt" "openai" "openai-codex" "opencode" "opencode-go" "opencode-zen" "openrouter" "zenmux" {
		thinking-mode "effort"
	}
	on "cloudflare-ai-gateway" "vercel-ai-gateway" {
		thinking-mode "budget"
	}
}
