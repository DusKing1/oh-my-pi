// Model-lineage compat for "openai"; regenerated from the frozen census using class taxonomy selectors.

class "openai" {
	on "aimlapi" "azure" "cloudflare-ai-gateway" "github-copilot" "gitlab-duo" "kilo" "nanogpt" \
		"openai" "opencode-zen" "openrouter" "vercel-ai-gateway" "zenmux" {
		family "gpt" {
			revision ">=5 <5.2" {
				thinking-efforts "minimal" "low" "medium" "high"
			}
		}
	}
	on "aimlapi" "azure" "cloudflare-ai-gateway" "github-copilot" "kilo" "nanogpt" "openai" \
		"openai-codex" "opencode" "opencode-zen" "openrouter" "vercel-ai-gateway" "zenmux" {
		revision ">=5.2 <5.6" {
			thinking-efforts "low" "medium" "high" "xhigh"
		}
	}
	on "aimlapi" "azure" "cloudflare-ai-gateway" "kilo" "nanogpt" "openai" "openrouter" \
		"vercel-ai-gateway" "zenmux" {
		family "o-series" {
			thinking-requires-effort #true
		}
	}
	on "aimlapi" "azure" "cloudflare-ai-gateway" "kilo" "openai" "vercel-ai-gateway" "zenmux" {
		family "o-series" {
			thinking-efforts "minimal" "low" "medium" "high" "xhigh"
		}
	}
	on "azure" "cloudflare-ai-gateway" "github-copilot" "kilo" "nanogpt" "openai" "openai-codex" \
		"opencode-go" "opencode-zen" "openrouter" "vercel-ai-gateway" "zenmux" {
		family "gpt" {
			revision ">=5.6 <5.7" {
				thinking-efforts "low" "medium" "high" "xhigh" "max"
			}
		}
	}
	on "azure" "gitlab-duo" "kilo" "nanogpt" "openai" "opencode-zen" "openrouter" "vercel-ai-gateway" \
		"zenmux" {
		family "codex" {
			revision ">=5 <5.1" {
				thinking-efforts "minimal" "low" "medium" "high"
			}
		}
	}
	on "cloudflare-ai-gateway" "vercel-ai-gateway" {
		thinking-mode "budget"
	}
}
