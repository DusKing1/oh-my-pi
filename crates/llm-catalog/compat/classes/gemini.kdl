// Model-lineage compat for "gemini"; regenerated from the frozen census using class taxonomy selectors.

class "gemini" {
	on "aimlapi" "cursor" "github-copilot" "google" "google-antigravity" "google-gemini-cli" \
		"google-vertex" "kilo" "nanogpt" "ollama-cloud" "opencode-zen" "openrouter" "vercel-ai-gateway" \
		"zenmux" {
		family "flash" {
			revision ">=2.5 <3.8" {
				thinking-efforts "minimal" "low" "medium" "high"
			}
		}
	}
	on "aimlapi" "cursor" "github-copilot" "google" "google-antigravity" "google-gemini-cli" \
		"google-vertex" "kilo" "nanogpt" "opencode-zen" "openrouter" "vercel-ai-gateway" "zenmux" {
		family "pro" {
			revision ">=3 <3.2" {
				thinking-efforts "low" "high"
			}
		}
	}
	on "aimlapi" "cursor" "github-copilot" "google" "google-gemini-cli" "google-vertex" "kilo" \
		"nanogpt" "ollama-cloud" "opencode-zen" "openrouter" "vercel-ai-gateway" "zenmux" {
		revision ">=3 <3.8" {
			thinking-requires-effort #true
		}
	}
	on "aimlapi" "github-copilot" "google" "google-antigravity" "google-gemini-cli" "google-vertex" \
		"kilo" "nanogpt" "openrouter" "vercel-ai-gateway" "zenmux" {
		family "pro" {
			revision ">=2.5 <3" {
				thinking-efforts "minimal" "low" "medium" "high"
				thinking-requires-effort #true
			}
		}
	}
	on "aimlapi" "google" "google-antigravity" "google-gemini-cli" "google-vertex" "kilo" "nanogpt" \
		"opencode-zen" "openrouter" "vercel-ai-gateway" "zenmux" {
		family "lite" {
			revision ">=2.5 <3.6" {
				thinking-efforts "minimal" "low" "medium" "high"
			}
		}
	}
	on "google" "google-antigravity" "google-gemini-cli" "google-vertex" "vercel-ai-gateway" {
		revision ">=1.6 <3" {
			thinking-mode "budget"
		}
	}
	on "google" "google-gemini-cli" "google-vertex" "opencode-zen" {
		revision ">=3 <3.8" {
			thinking-mode "google-level"
		}
	}
	on "nanogpt" "venice" {
		family "pro" {
			revision ">=3 <3.1" {
				supports-usage-in-streaming #false
			}
		}
	}
}
