// Model-lineage compat for the "mistral" class (census: model-class predicates in pi
// dialect selection / transform-messages; oracle-verified by tests/compat_cascade.rs).

class "mistral" {
	on "amazon-bedrock" "openrouter" {
		thinking-efforts "minimal" "low" "medium" "high"
	}
	on "amazon-bedrock" "vercel-ai-gateway" {
		thinking-mode "budget"
	}
	on "kilo" "mistral" "nanogpt" "nvidia" "openrouter" "scaleway" "venice" {
		thinking-mode "effort"
	}
	on "kilo" "mistral" "nanogpt" "nvidia" "scaleway" "venice" "vercel-ai-gateway" {
		thinking-efforts "minimal" "low" "medium" "high" "xhigh"
	}
}
