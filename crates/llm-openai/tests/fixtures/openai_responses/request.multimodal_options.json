{
  "wire_body": {
    "model": "gpt-5",
    "input": [
      {
        "role": "user",
        "content": [
          {
            "type": "input_image",
            "image_url": "data:image/png;base64,aW1n",
            "detail": "high"
          }
        ],
        "cache_control": {"type": "ephemeral"},
        "metadata": {"source": "camera"}
      },
      {
        "role": "user",
        "content": [
          {
            "type": "input_file",
            "file_data": "data:application/pdf;base64,cGRm",
            "filename": "notes.pdf"
          }
        ]
      }
    ],
    "stream": true,
    "store": false,
    "prompt_cache_key": "session-redacted",
    "prompt_cache_retention": "24h",
    "tools": [
      {"type": "web_search", "search_context_size": "low"},
      {"type": "code_interpreter", "container": {"type": "auto"}}
    ],
    "include": ["web_search_call.results", "code_interpreter_call.outputs"],
    "service_tier": "priority",
    "text": {"verbosity": "low"},
    "metadata": {"trace": "trace-redacted"},
    "parallel_tool_calls": true
  }
}
