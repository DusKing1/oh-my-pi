{
  "category": "auth-error",
  "expectations": [
    {
      "expected": "Secret([redacted])",
      "forbidden_substrings": [
        "fixture-access-token-AAA111"
      ],
      "id": "secret.debug.redacted.v1",
      "operation": "format secret with debug and display",
      "source": "archive/llm-legacy/llm-broker/src/sealed.rs::tests::secret_debug_and_display_are_redacted"
    },
    {
      "expected": "AppliedAuth([redacted])",
      "forbidden_substrings": [
        "fixture-api-key-CCC333",
        "fixture-aws-secret-DDD444"
      ],
      "id": "applied.auth.debug.redacted.v1",
      "operation": "format applied auth with debug",
      "source": "archive/llm-legacy/llm-broker/src/sealed.rs::AppliedAuth::fmt"
    },
    {
      "expected_contains": "credentials: \"[REDACTED]\"",
      "forbidden_substrings": [
        "AKIAFIXTURE000000000",
        "fixture-aws-secret-DDD444",
        "fixture-aws-session-EEE555"
      ],
      "id": "aws.engine.debug.redacted.v1",
      "operation": "format AWS engine with debug",
      "source": "archive/llm-legacy/llm-broker/src/aws.rs::AwsEngine::fmt"
    },
    {
      "expected": "credential refresh failed",
      "forbidden_substrings": [
        "fixture-refresh-token-BBB222",
        "fixture-access-token-AAA111"
      ],
      "id": "refresh.error.redacted.v1",
      "invariant": "nested provider error is retained as source for callers but broker display/debug does not expose it",
      "operation": "format nested refresh failure",
      "source": "archive/llm-legacy/llm-broker/src/source.rs::BrokerCredentialSourceError::Refresh"
    },
    {
      "allowed_fields": [
        "sanitized_error_code",
        "http_status",
        "transient_boolean"
      ],
      "expected": "OAuth provider error `invalid_grant` (HTTP 400)",
      "forbidden_fields": [
        "response_body",
        "access_token",
        "refresh_token",
        "authorization_header",
        "cookie"
      ],
      "id": "oauth.provider.error.shape.v1",
      "operation": "format provider rejection",
      "source": "archive/llm-legacy/llm-broker/src/oauth.rs::OAuthError::Provider"
    },
    {
      "allowed_fields": [
        "id",
        "provider",
        "kind",
        "identity",
        "state",
        "blocks",
        "disabled_cause",
        "expires_at_ms",
        "created_at_ms",
        "updated_at_ms"
      ],
      "forbidden_fields": [
        "secret",
        "access_token",
        "refresh_token",
        "aws_access_key",
        "aws_session_token"
      ],
      "id": "credential.meta.client.safe.v1",
      "operation": "serialize client-visible metadata",
      "source": "archive/llm-legacy/llm-broker/src/store.rs::CredentialMeta"
    },
    {
      "expected": "synthetic material appears only in protected outbound request header/query at dispatch boundary",
      "forbidden_surfaces": [
        "RPC response",
        "credential metadata",
        "debug output",
        "display output",
        "manifest",
        "provider error message"
      ],
      "id": "request.placement.boundary.v1",
      "operation": "apply auth to outbound request",
      "source": "archive/llm-legacy/llm-broker/src/sealed.rs::tests::direct_request_placement_exposes_material_only_in_request_parts"
    },
    {
      "id": "account.identifier.sanitized.v1",
      "invariant": "wire shape and classification behavior remain while production identifiers do not leave archive",
      "operation": "export mined identifiers",
      "replacements": [
        {
          "fixture": "req_fixture0000000000000000000",
          "source_shape": "req_<provider-id>"
        },
        {
          "fixture": "rs_fixture",
          "source_shape": "rs_<session-item-id>"
        },
        {
          "fixture": "fixture.user@example.test",
          "source_shape": "account identity"
        }
      ],
      "source": "archive/llm-legacy/llm-error/tests/corpus.rs::anthropic_overloaded_sse_frame"
    }
  ],
  "fixture": "redaction-expectations",
  "oracle_scan": {
    "all_fixture_entries_secret_free": true,
    "allow_domains": [
      "example.test"
    ],
    "forbid_patterns": [
      "sk-[A-Za-z0-9_-]{12,}",
      "AKIA[0-9A-Z]{16}(?!FIXTURE)",
      "(?i)bearer\\s+(?!<redacted>|fixture)[A-Za-z0-9._~-]{12,}",
      "(?i)(access_token|refresh_token|api_key|secret_access_key)\\s*[:=]\\s*(?!<synthetic|<sealed|<redacted|fixture)[^,}\\s]{8,}"
    ]
  },
  "schema_version": 1,
  "synthetic_material": [
    {
      "label": "oauth_access_token",
      "value": "fixture-access-token-AAA111"
    },
    {
      "label": "oauth_refresh_token",
      "value": "fixture-refresh-token-BBB222"
    },
    {
      "label": "api_key",
      "value": "fixture-api-key-CCC333"
    },
    {
      "label": "aws_access_key_id",
      "value": "AKIAFIXTURE000000000"
    },
    {
      "label": "aws_secret_access_key",
      "value": "fixture-aws-secret-DDD444"
    },
    {
      "label": "aws_session_token",
      "value": "fixture-aws-session-EEE555"
    },
    {
      "label": "account_identity",
      "value": "fixture.user@example.test"
    }
  ]
}
