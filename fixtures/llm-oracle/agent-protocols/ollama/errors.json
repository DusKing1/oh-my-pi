              "function": {}
            }
          ]
        }
      },
      "expected": {
        "decode_error_kind": "provider",
        "detail": "Ollama tool call is missing name"
      }
    },
    {
      "input": {
        "message": {
          "tool_calls": [
            {}
          ]
        }
      },
      "expected": {
        "decode_error_kind": "provider",
        "detail": "Ollama tool call is missing function"
      }
    },
    {
      "input": "stream EOF before done=true",
      "fixture": "malformed_terminal.ndjson",
      "expected": {
        "error_kind": "upstream",
        "detail": "Ollama NDJSON stream ended before a done terminal chunk",
        "terminal_count": 1
