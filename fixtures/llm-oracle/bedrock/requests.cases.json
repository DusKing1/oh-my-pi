        "thread": [
          {
            "kind": "message",
            "role": "system",
            "parts": [
              {
                "kind": "text",
                "text": "Answer concisely."
              }
            ]
          },
          {
            "kind": "message",
            "role": "user",
            "parts": [
              {
                "kind": "text",
                "text": "Hello, Bedrock."
              }
            ]
          }
        ],
        "sampling": {
          "max_output_tokens": 128,
          "temperature": 0.2,
          "top_p": 0.9,
          "stop": [
