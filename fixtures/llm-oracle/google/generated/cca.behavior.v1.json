        {
          "failure": "empty_body",
          "response_started": false,
          "retry_next_host": true
        },
        {
          "failure": "first_event_timeout",
          "response_started": false,
          "retry_next_host": true
        },
        {
          "failure": "incomplete_stream",
          "response_started": false,
          "retry_next_host": false
        },
        {
          "failure": "output",
          "response_started": false,
          "retry_next_host": false
        },
        {
          "failure": {
            "http_status": 503
          },
          "response_started": true,
          "retry_next_host": false
        }
      ],
      "first_event_timeout_ms": {
        "model_contains_flash": 60000,
        "other": 300000
      }
    },
    {
      "id": "google.cca.malformed-and-signature-errors.v1",
      "cases": [
        {
          "input": "[]",
          "operation": "unwrap_response",
          "error": {
            "kind": "provider",
            "detail": "CCA stream event is not an object"
          }
        },
        {
          "input": {},
          "operation": "unwrap_response",
          "error": {
            "kind": "provider",
            "detail": "CCA stream event has no response"
          }
        },
        {
          "input": {
            "error": {
              "code": 500,
              "message": "upstream failed"
            }
          },
          "operation": "unwrap_response",
          "error": {
            "kind": "provider",
            "detail": "CCA in-band error: {\"code\":500,\"message\":\"upstream failed\"}"
          }
        },
        {
          "input_bytes_hex": "ff",
          "operation": "thought_signature_to_wire",
          "error": {
            "kind": "provider",
            "detail_prefix": "CCA thought signature is not UTF-8:"
          }
        },
        {
          "input": "not-json",
          "operation": "stream_decode",
          "error": {
            "kind": "provider",
            "detail_prefix": "invalid CCA response JSON:"
          }
        }
      ]
    },
    {
      "id": "google.cca.shared-generation-config.v1",
      "input": {
        "temperature": 0.2,
        "top_p": 0.9,
        "top_k": 32,
        "max_output_tokens": 2048,
