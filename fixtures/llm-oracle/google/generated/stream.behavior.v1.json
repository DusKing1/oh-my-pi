{
  "schema_version": 1,
  "retry": {
    "empty_stream": [
      {
        "decision": "retry",
        "delay_ms": 500
      },
      {
        "decision": "retry",
        "delay_ms": 1000
      },
      {
        "decision": "terminal"
      }
    ],
    "empty_response": [
      {
        "decision": "retry",
        "delay_ms": 500
      },
      {
        "decision": "retry",
        "delay_ms": 1000
      },
      {
        "decision": "terminal"
      }
    ],
    "overload": [
      {
        "decision": "retry",
        "delay_ms": 1000
      },
      {
        "decision": "retry",
        "delay_ms": 2000
      },
      {
        "decision": "terminal"
      }
    ],
    "after_cancellation": {
      "empty_stream": {
        "decision": "terminal"
      },
      "empty_response": {
        "decision": "terminal"
      },
      "overload": {
        "decision": "terminal"
      }
    }
  },
  "errors": [
