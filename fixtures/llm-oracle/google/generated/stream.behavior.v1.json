        "retry_after_ms": 1000
      }
    },
    {
      "input": {
        "code": 503,
        "status": "UNAVAILABLE",
        "message": "high demand"
      },
      "output": {
        "kind": "overloaded",
        "detail": "high demand",
        "retry_after_ms": 1000
      }
    },
    {
      "input": {
        "code": 400,
        "status": "INVALID_ARGUMENT",
        "message": "input token count exceeds the maximum"
      },
      "output": {
        "kind": "upstream",
        "detail": "input token count exceeds the maximum",
