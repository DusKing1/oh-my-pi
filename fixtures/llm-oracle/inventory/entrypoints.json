  "smoke_scenarios": [
    {
      "id": "app.smoke.daemon-composition.v1",
      "scenario": "process daemon startup failures, TLS policy, auth migration/list, readiness/Hello/capabilities/health, facade mounts, provider/model listing, native Turn success and classified failure, secret non-disclosure, SIGTERM drain and socket cleanup",
