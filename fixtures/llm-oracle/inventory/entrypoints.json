  "daemon_composition_order": [
    {
      "behavior": "resolve data/project/token/listener/facet inputs",
      "component": "DaemonConfig",
      "order": 1
    },
    {
      "behavior": "load built-ins and user/project overlays; reject empty catalogs",
      "component": "provider and model catalogs",
      "order": 2
    },
    {
      "behavior": "open durable broker; bootstrap catalog credentials without exposing them",
      "component": "Store/Egress/AWS/ADC/OAuth",
      "order": 3
    },
    {
      "behavior": "join model cards, provider routes, credential availability",
      "component": "Registry/ChatResolver",
      "order": 4
    },
    {
      "behavior": "inject exact credential lease at final egress; per-provider/credential bounds",
      "component": "AuthInject + KeyedLimits",
      "order": 5
    },
    {
      "behavior": "register eight specialized protocols over authenticated discovery HTTP",
      "component": "Discovery",
      "order": 6
    },
    {
      "behavior": "mount Apple, Cursor, Devin, GitLab routes when available",
      "component": "specialized transports",
      "order": 7
    },
    {
      "behavior": "register chat, count, embed, audio, search, image, video implementations",
      "component": "operation routers",
      "order": 8
    },
    {
      "behavior": "cache, usage, refresh, repair, recovery, admission, timeouts, dialect, codec, transport",
      "component": "provider attempt stack",
      "order": 9
    },
    {
      "behavior": "canonical in-process operations and context state",
      "component": "Facets/TurnEngine/InferenceService",
      "order": 10
    },
    {
      "behavior": "OpenAI/Anthropic-compatible HTTP routes guarded by gateway bearer",
      "component": "Facade Router",
      "order": 11
    },
    {
      "behavior": "mount inference/auth/blob/facade/hello; readiness only after bind",
      "component": "LocalListener/RemoteListener + Services",
      "order": 12
    },
    {
      "behavior": "signal or listener completion initiates graceful drain and removes local endpoints",
      "component": "shutdown",
      "order": 13
    }
  ],
