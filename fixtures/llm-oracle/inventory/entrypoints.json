    },
    {
      "id": "app.smoke.owned-tool-native.v1",
      "scenario": "production dialect streams exactly one tool, executes once, appends canonical call/result, and serializes follow-up",
      "source": "crates/app/tests/agent_tool_loop.rs:322"
    },
    {
      "id": "app.smoke.owned-tool-failure-result.v1",
      "scenario": "tool execution failure becomes authoritative tool result rather than loop failure",
      "source": "crates/app/tests/agent_tool_loop.rs:403"
    },
